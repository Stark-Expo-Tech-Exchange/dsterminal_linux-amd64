#!/bin/bash
set -e

echo "Removing DSTerminal..."

# Remove launcher
rm -f /usr/bin/dsterminal 2>/dev/null || true

# Remove systemd service
if [ -f /usr/lib/systemd/system/dsterminal.service ]; then
    systemctl stop dsterminal.service 2>/dev/null || true
    systemctl disable dsterminal.service 2>/dev/null || true
    rm -f /usr/lib/systemd/system/dsterminal.service 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
fi

echo ""
echo "Do you want to remove DSTerminal data files as well?"
echo "  [1] Keep data (reports, logs, workspace)"
echo "  [2] Remove all data"
echo -n "Select option (1-2): "
read choice

if [ "$choice" = "2" ]; then
    echo "Removing data files..."
    rm -rf /var/lib/dsterminal 2>/dev/null || true
    rm -rf /var/log/dsterminal 2>/dev/null || true
    rm -rf /etc/dsterminal 2>/dev/null || true
    echo "Data removed."
else
    echo "Data kept at:"
    echo "  /var/lib/dsterminal/workspace"
    echo "  /var/log/dsterminal"
    echo "  /etc/dsterminal"
fi

echo "DSTerminal removed successfully."
exit 0
